{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"includes": [
			"**/src/**/*",
			"**/plugins/**/hooks/**/*",
			"**/*.config.ts",
			"**/*.stories.tsx",
			"**/index.html",
			"**/vite.config.ts",
			"!**/test-results",
			"!**/playwright-report",
			"!**/.vitest-coverage*",
			"!**/storybook-static",
			"!**/src/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 400
					}
				}
			},
			"suspicious": {
				"noConsole": {
					"level": "error",
					"options": { "allow": ["error"] }
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": "off"
					},
					"suspicious": {
						"noThenProperty": "off",
						"noConsole": "off"
					}
				}
			}
		}
	]
}
